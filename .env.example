# Пароль ведущего — ОБЯЗАТЕЛЬНО задай на хостинге. На странице /host игра попросит его ввести.
HOST_KEY=придумай-пароль

# Порт обычно задаёт сам хостинг. Если нет — 3000.
# PORT=3000

# Адрес сайта для ссылки и QR-кода игрокам. Обычно определяется сам, задай, если ссылка неправильная.
# PUBLIC_URL=https://svoya-igra.example.com
