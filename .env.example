# Пароль ведущего — ОБЯЗАТЕЛЬНО задай свой на хостинге. На странице /host игра попросит его ввести.
# Если оставить пустым, сервер придумает ключ сам и напишет его в логах при запуске.
HOST_KEY=

# Порт обычно задаёт сам хостинг. Если нет — 3000.
# PORT=3000

# Адрес сайта для ссылки и QR-кода игрокам. Обычно определяется сам, задай, если ссылка неправильная.
# PUBLIC_URL=https://svoya-igra.example.com
